# Exactly the toolchain line of backend/go.mod; GOTOOLCHAIN=local makes a
# go.mod this image cannot build an error, never a toolchain download.
FROM golang:1.27.4-alpine3.24 AS builder
ENV GOTOOLCHAIN=local
RUN apk add --no-cache git
WORKDIR /app
COPY go.mod go.sum ./
# go.mod replaces github.com/go-routeros/routeros/v3 with the patched copy in
# third_party: it has to be there before the modules are resolved.
COPY third_party ./third_party
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /mikrotik-nms ./cmd/mikrotik-nms

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /mikrotik-nms /usr/local/bin/mikrotik-nms
EXPOSE 8080 2055/udp
ENTRYPOINT ["mikrotik-nms"]
