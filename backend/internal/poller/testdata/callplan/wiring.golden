== (*Auditor).Run in audit.go
{
if !sleepCtx(ctx, auditLoopDelay) {
return
}
for {
now := a.now()
wake := a.safeTick(now)
wait := min(max(wake.Sub(now), 200*time.Millisecond), pollerTick)
timer := time.NewTimer(wait)
select {
case <-ctx.Done():
timer.Stop()
return
case <-a.kick:
timer.Stop()
case <-timer.C:
}
}
}

